    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "wagmi.config.ts",
